# Copiar a .env y ajustar. Valores de DESARROLLO local (coinciden con docker-compose.yml).
# Nunca subir el archivo .env al repositorio.

# Base de datos principal (MySQL 8.4)
DATABASE_URL="mysql://canchaya:canchaya@localhost:3306/canchaya"
# Base temporal que Prisma usa para calcular migraciones (prisma migrate dev)
SHADOW_DATABASE_URL="mysql://canchaya:canchaya@localhost:3306/canchaya_shadow"
# Base exclusiva de las pruebas automatizadas (se limpia en cada ejecución)
TEST_DATABASE_URL="mysql://canchaya:canchaya@localhost:3306/canchaya_test"

# Servidor de la API
API_PORT=3000
API_HOST=127.0.0.1
LOG_LEVEL=info

# Zona horaria del complejo deportivo (ADR-007)
TZ_COMPLEX=America/Panama
